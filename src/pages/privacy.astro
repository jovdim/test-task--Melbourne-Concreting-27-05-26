---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy Policy | Melbourne Concreting Co"
  description="How Melbourne Concreting Co handles your personal information, in line with the Australian Privacy Principles."
>
  <main id="main" class="privacy-page">
    <div class="container">
      <a class="back" href="/">&larr; Back to home</a>
      <h1>Privacy Policy</h1>
      <p class="note">
        This page is a placeholder. Add your privacy policy here before launch. It should cover
        what personal information you collect (for example, through the quote form), how it is
        used and stored, who it is shared with, and how visitors can contact you about their
        data, in line with the Australian Privacy Principles.
      </p>
    </div>
  </main>

  <style>
    .privacy-page { padding: clamp(110px, 16vh, 200px) 0 clamp(64px, 10vh, 120px); }
    .privacy-page .container { max-width: 720px; }
    .back { display: inline-block; margin-bottom: 2rem; font-weight: 600; color: var(--accent-strong); }
    .back:hover { color: var(--accent); }
    .privacy-page h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
    .note { margin-top: 1.4rem; color: var(--slate); font-size: 1.1rem; line-height: 1.75; }
  </style>
</Base>
