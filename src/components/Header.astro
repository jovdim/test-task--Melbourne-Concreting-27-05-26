---
import { business, nav } from '../data/site';

const phoneIcon =
  'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z';
---

<header class="site-header" data-header>
  <div class="container bar">
    <a href="#top" class="brand" aria-label={`${business.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="38" height="38">
          <rect width="64" height="64" rx="13" fill="#16181d"></rect>
          <text x="32" y="29" text-anchor="middle" dominant-baseline="central"
            font-family="Fraunces, Georgia, serif" font-weight="600" font-size="36" fill="#db8b2e">M</text>
          <rect x="17" y="46" width="30" height="4.5" rx="2.25" fill="#db8b2e"></rect>
        </svg>
      </span>
      <span class="brand-text">
        <strong>Melbourne Concreting</strong>
        <span>Melbourne, VIC</span>
      </span>
    </a>

    <nav class="nav" data-nav aria-label="Primary">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="btn btn--primary nav-call" href={`tel:${business.phoneHref}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={phoneIcon}></path></svg>
        {business.phone}
      </a>
    </nav>

    <div class="bar-actions">
      <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    color: #fff;
    transition: background .3s ease, box-shadow .3s ease, color .3s ease, backdrop-filter .3s ease;
  }
  .bar { display: flex; align-items: center; gap: 1rem; height: 78px; }

  .site-header.is-scrolled {
    background: rgba(250, 248, 244, .9);
    backdrop-filter: saturate(1.2) blur(10px);
    box-shadow: 0 1px 0 var(--line), var(--shadow-sm);
    color: var(--ink);
  }

  /* brand */
  .brand { display: inline-flex; align-items: center; gap: .7rem; margin-right: auto; }
  .brand-mark svg { display: block; border-radius: 11px; box-shadow: var(--shadow-sm); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text strong { font-family: var(--font-head); font-weight: 600; font-size: 1.15rem; letter-spacing: -.01em; }
  .brand-text span { font-size: .72rem; letter-spacing: .04em; opacity: .75; }

  /* nav */
  .nav { display: flex; align-items: center; gap: clamp(1.1rem, 2.6vw, 2.4rem); }
  .nav ul { display: flex; align-items: center; gap: clamp(.9rem, 2vw, 1.9rem); list-style: none; padding: 0; }
  .nav ul a { font-weight: 500; font-size: .98rem; opacity: .9; transition: opacity .2s; position: relative; }
  .nav ul a::after {
    content: ""; position: absolute; left: 0; bottom: -5px; height: 2px; width: 0;
    background: var(--accent); transition: width .25s ease;
  }
  .nav ul a:hover { opacity: 1; }
  .nav ul a:hover::after { width: 100%; }

  .nav-call { padding: .68rem 1.2rem; font-size: .95rem; white-space: nowrap; }
  .nav-call svg { flex: none; }

  /* mobile-only bar actions */
  .bar-actions { display: none; align-items: center; }

  /* hamburger */
  .nav-toggle { display: flex; flex-direction: column; gap: 5px; width: 44px; height: 44px;
    align-items: center; justify-content: center; background: none; border: 0; cursor: pointer; }
  .nav-toggle span { display: block; width: 24px; height: 2px; background: currentColor; border-radius: 2px;
    transition: transform .3s ease, opacity .3s ease; }

  @media (max-width: 760px) {
    .bar-actions { display: flex; }
    .nav {
      position: fixed; inset: 78px 0 0 0; z-index: 99;
      flex-direction: column; justify-content: flex-start; gap: 0;
      background: var(--bg); color: var(--ink);
      padding: 2rem var(--pad) 3rem;
      transform: translateX(100%); transition: transform .35s cubic-bezier(.2,.7,.2,1);
      visibility: hidden;
    }
    .nav.is-open { transform: none; visibility: visible; }
    .nav ul { flex-direction: column; align-items: stretch; gap: 0; width: 100%; }
    .nav ul li { border-bottom: 1px solid var(--line); }
    .nav ul a { display: block; padding: 1.1rem 0; font-size: 1.2rem; font-family: var(--font-head); opacity: 1; }
    .nav ul a::after { display: none; }
    .nav-call { display: inline-flex; width: 100%; margin-top: 1.8rem; padding: 1rem; font-size: 1.05rem; }

    .site-header:has(.nav.is-open) { color: var(--ink); background: var(--bg); }
    .site-header:has(.nav.is-open) .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header:has(.nav.is-open) .nav-toggle span:nth-child(2) { opacity: 0; }
    .site-header:has(.nav.is-open) .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
