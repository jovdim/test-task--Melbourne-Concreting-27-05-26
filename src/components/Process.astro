---
import { Image } from 'astro:assets';
import { process, images } from '../data/site';
---

<section class="section section--ink on-dark process grid-bg grid-bg--ink" id="process">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{process.eyebrow}</p>
      <h2 set:html={process.h2}></h2>
    </div>

    <div class="grid">
      <div class="media" data-reveal>
        <Image
          src={images.processCrew}
          alt="Concreting crew spreading and levelling freshly poured concrete on site"
          widths={[480, 760, 1100]}
          sizes="(max-width: 900px) 100vw, 44vw"
          loading="lazy"
        />
      </div>

      <ol class="steps">
        {process.steps.map((s, i) => (
          <li data-reveal style={`transition-delay:${0.05 + i * 0.06}s`}>
            <span class="num">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <a class="btn btn--primary cta" href="#quote" data-reveal>Book my free quote</a>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(36px, 5vw, 72px); align-items: stretch; }

  /* image stretches to match the steps column height */
  .media { position: relative; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); min-height: 420px; }
  .media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .cta { margin-top: clamp(36px, 4vw, 52px); }

  .section--ink h2, .section--ink h3 { color: #fff; }
  .section--ink .section-head .eyebrow { color: var(--accent); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; align-content: center; }
  .steps li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1.3rem; padding: 0 0 30px; }
  .steps li:last-child { padding-bottom: 0; }
  /* connecting line */
  .steps li::before {
    content: ""; position: absolute; left: 27px; top: 56px; bottom: -4px; width: 2px;
    background: linear-gradient(var(--accent), rgba(219,139,46,.15));
  }
  .steps li:last-child::before { display: none; }

  .num {
    flex: none; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; position: relative; z-index: 1;
    font-family: var(--font-head); font-weight: 600; font-size: 1.15rem;
    color: var(--accent); background: #1e2128; border: 1.5px solid rgba(219,139,46,.45);
  }
  .steps h3 { font-size: 1.3rem; margin-top: 9px; }
  .steps p { margin-top: 8px; color: rgba(233,231,225,.78); font-size: 1rem; line-height: 1.6; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .media { min-height: 0; aspect-ratio: 4 / 3; }
    .cta { width: 100%; }
  }
</style>
