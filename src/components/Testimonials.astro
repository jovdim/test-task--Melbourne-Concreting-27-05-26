---
import { testimonials } from '../data/site';

// Multicolour Google "G" mark, signalling the reviews come from Google.
const googleG = `<svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34A21.99 21.99 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg>`;
---

<section class="section testimonials grid-bg">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">From homeowners</p>
      <h2>Driveways the <span class="hl">neighbours</span> notice</h2>
    </div>

    <div class="grid">
      {testimonials.map((t, i) => (
        <figure class="quote-card" data-reveal style={`transition-delay:${i * 0.07}s`}>
          <div class="stars" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.26 6.85.6-5.18 4.52L18.18 22 12 18.27 5.82 22l1.61-8.62L2.25 8.86l6.85-.6L12 2z"/></svg>
            ))}
          </div>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="g-badge" set:html={googleG} />
            <strong class="who">{t.name}</strong>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2.2vw, 28px); }

  .quote-card {
    margin: 0; padding: clamp(26px, 2.6vw, 36px); border-radius: var(--r-lg);
    background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; gap: 18px;
  }
  .stars { color: var(--accent); display: inline-flex; gap: 2px; }
  blockquote {
    font-family: var(--font-head); font-weight: 400; font-size: 1.18rem; line-height: 1.5;
    color: var(--ink-2); letter-spacing: -.005em; flex: 1;
  }
  blockquote::before { content: "\201C"; }
  blockquote::after { content: "\201D"; }

  figcaption { display: flex; align-items: center; gap: .8rem; }
  .g-badge {
    width: 44px; height: 44px; border-radius: 50%; flex: none;
    display: grid; place-items: center; background: #fff; border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .who { font-weight: 600; }

  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
