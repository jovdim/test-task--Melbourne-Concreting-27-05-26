---
import { business, services, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand-col">
        <a href="#top" class="brand" aria-label={`${business.name} home`}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="40" height="40"><rect width="64" height="64" rx="13" fill="#23262e"></rect><text x="32" y="29" text-anchor="middle" dominant-baseline="central" font-family="Fraunces, Georgia, serif" font-weight="600" font-size="36" fill="#db8b2e">M</text><rect x="17" y="46" width="30" height="4.5" rx="2.25" fill="#db8b2e"></rect></svg>
          </span>
          <span>Melbourne Concreting Co</span>
        </a>
        <p class="tagline">{business.tagline}</p>
        <div class="social" aria-label="Social links">
          <a href={business.social.facebook} aria-label="Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg></a>
          <a href={business.social.instagram} aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href={business.social.google} aria-label="Google Business Profile" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21.35 11.1H12v3.2h5.35c-.25 1.6-1.9 4.7-5.35 4.7a5.9 5.9 0 0 1 0-11.8 5.3 5.3 0 0 1 3.75 1.47l2.5-2.4A9 9 0 1 0 12 21c5.2 0 8.6-3.65 8.6-8.8 0-.6-.05-1.05-.15-1.1z"/></svg></a>
        </div>
      </div>

      <nav class="col" aria-label="Services">
        <h4>Services</h4>
        <ul>{services.map((s) => <li><a href="#services">{s.title}</a></li>)}</ul>
      </nav>

      <nav class="col" aria-label="Pages">
        <h4>Explore</h4>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="#quote">Get a quote</a></li>
        </ul>
      </nav>

      <div class="col">
        <h4>Get in touch</h4>
        <ul class="contact-list">
          <li><a href={`tel:${business.phoneHref}`}>{business.phone}</a></li>
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li class="muted">Mon–Fri 7am–5pm · Sat 8am–1pm</li>
        </ul>
        <p class="reg">ABN {business.abn}<br />ACN {business.acn}</p>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} {business.name} · Fully licensed &amp; insured · <a href="/privacy">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #c8cad0; padding-block: clamp(48px, 6vw, 76px) 28px; }
  .top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.3fr; gap: clamp(28px, 4vw, 56px); padding-bottom: 44px; border-bottom: 1px solid rgba(255,255,255,.1); }

  .brand { display: inline-flex; align-items: center; gap: .65rem; color: #fff; font-family: var(--font-head); font-weight: 600; font-size: 1.2rem; }
  .mark svg { border-radius: 11px; }
  .tagline { margin-top: 16px; max-width: 34ch; font-size: .96rem; line-height: 1.6; color: #9da1a9; }

  .social { display: flex; gap: .6rem; margin-top: 20px; }
  .social a { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.07); color: #c8cad0; transition: background .2s, color .2s, transform .2s; }
  .social a:hover { background: var(--accent); color: var(--accent-ink); transform: translateY(-2px); }

  .col h4 { font-family: var(--font-body); font-size: .82rem; text-transform: uppercase; letter-spacing: .12em; color: #fff; font-weight: 600; margin-bottom: 16px; }
  .col ul { list-style: none; padding: 0; display: grid; gap: 11px; }
  .col a { font-size: .96rem; color: #b6b9c0; transition: color .2s; }
  .col a:hover { color: var(--accent); }
  .contact-list a { font-weight: 600; color: #e7e8ec; }
  .muted { color: #8a8e96; font-size: .92rem; }
  .reg { margin-top: 16px; font-size: .85rem; line-height: 1.7; color: #8a8e96; }

  .bottom { padding-top: 24px; text-align: center; font-size: .85rem; color: #82868e; }
  .bottom a { color: #b6b9c0; text-decoration: underline; text-underline-offset: 2px; }
  .bottom a:hover { color: var(--accent); }

  @media (max-width: 860px) { .top { grid-template-columns: 1fr 1fr; } .brand-col { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .top { grid-template-columns: 1fr; } }
</style>
