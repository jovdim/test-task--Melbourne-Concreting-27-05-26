---
import { Image } from 'astro:assets';
import { services } from '../data/site';

// On-brand line icons per service (concrete / trade motifs).
const icons: Record<string, string> = {
  driveways: '<path d="M6 21 9 3h6l3 18"/><path d="M12 6v3M12 12v3"/>',
  pathways: '<path d="M6 21V9a3 3 0 0 1 6 0v6a3 3 0 0 0 6 0V5"/>',
  'shed-slabs': '<path d="M3 21h18M4 21v-8l8-5 8 5v8M10 21v-4h4v4"/>',
  'pool-surrounds': '<rect x="3" y="8" width="18" height="12" rx="2"/><path d="M6 13c1.2-1.2 2.4 0 3.6-1.2S13.8 11 15 12"/>',
};

const primary = services.find((s) => s.primary)!;
const rest = services.filter((s) => !s.primary);
const indexOf = (slug: string) => String(services.findIndex((s) => s.slug === slug) + 1).padStart(2, '0');
---

<section class="section section--sand grid-bg" id="services">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What we pour</p>
      <h2>Residential concreting, <span class="hl">done properly</span></h2>
      <p class="lede">Driveways are what most people call us for. While we’re on site, we also pour the path, the shed slab and the area around the pool, so it all matches and there’s only one crew to deal with.</p>
    </div>

    <div class="services-grid">
      <article class="card card--primary" data-reveal>
        <div class="card-media">
          <Image src={primary.image} alt={primary.alt} widths={[480, 760, 1000]} sizes="(max-width: 960px) 100vw, 48vw" loading="lazy" />
          <span class="badge">Most requested</span>
          <span class="card-no">{indexOf(primary.slug)}</span>
        </div>
        <div class="card-body">
          <span class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[primary.slug]} />
          </span>
          <h3>{primary.title}</h3>
          <p>{primary.blurb}</p>
          <a class="link-arrow" href="#quote">Get a driveway quote
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>

      {rest.map((s, i) => (
        <article class="card" data-reveal style={`transition-delay:${0.05 + i * 0.06}s`}>
          <div class="card-media">
            <Image src={s.image} alt={s.alt} widths={[380, 600, 800]} sizes="(max-width: 960px) 100vw, 30vw" loading="lazy" />
            <span class="card-no">{indexOf(s.slug)}</span>
          </div>
          <div class="card-body">
            <span class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.slug]} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 30px); }

  .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    display: flex; flex-direction: column; position: relative;
    transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s, border-color .3s;
  }
  .card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }

  .card-media { position: relative; overflow: hidden; aspect-ratio: 3 / 2; border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .card-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .card:hover .card-media :global(img) { transform: scale(1.06); }

  .badge {
    position: absolute; top: 14px; left: 14px;
    background: var(--accent); color: var(--accent-ink);
    font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: .4rem .7rem; border-radius: var(--r-pill); box-shadow: var(--shadow-sm);
  }
  .card-no {
    position: absolute; top: 12px; right: 16px;
    font-family: var(--font-head); font-size: 1.5rem; font-weight: 600;
    color: #fff; opacity: .55; text-shadow: 0 1px 8px rgba(0,0,0,.4);
  }

  /* icon badge overlaps the seam between image and body */
  .card-body { position: relative; padding: 36px clamp(20px, 2vw, 28px) clamp(22px, 2vw, 28px); display: flex; flex-direction: column; gap: 12px; }
  .card-icon {
    position: absolute; top: 0; left: clamp(20px, 2vw, 28px); transform: translateY(-50%);
    width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--line); color: var(--ink);
    box-shadow: var(--shadow-sm); transition: background .3s, color .3s, transform .3s;
  }
  .card-icon svg { width: 28px; height: 28px; }
  .card:hover .card-icon { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); transform: translateY(-50%) rotate(-4deg); }

  .card-body h3 { color: var(--ink); }
  .card-body p { color: var(--slate); font-size: .98rem; line-height: 1.6; }
  .card-body .link-arrow { margin-top: 6px; }

  /* primary card spans the row, lays out horizontally */
  .card--primary { grid-column: 1 / -1; flex-direction: row; }
  .card--primary .card-media { aspect-ratio: auto; flex: 1 1 50%; min-height: 340px; border-radius: var(--r-lg) 0 0 var(--r-lg); }
  .card--primary .card-body { flex: 1 1 50%; justify-content: center; gap: 16px; padding: clamp(34px, 4vw, 60px); }
  .card--primary .card-icon { position: static; transform: none; }
  .card--primary:hover .card-icon { transform: rotate(-4deg); }
  .card--primary h3 { font-size: clamp(1.7rem, 2.6vw, 2.3rem); margin-top: 8px; }
  .card--primary p { font-size: 1.05rem; }

  @media (max-width: 960px) {
    .services-grid { grid-template-columns: 1fr 1fr; }
    .card--primary { flex-direction: column; }
    .card--primary .card-media { min-height: 0; aspect-ratio: 16 / 9; border-radius: var(--r-lg) var(--r-lg) 0 0; }
    .card--primary .card-body { padding: 36px clamp(20px, 3vw, 32px) clamp(24px, 3vw, 32px); }
    .card--primary .card-icon { position: absolute; top: 0; left: clamp(20px, 3vw, 32px); transform: translateY(-50%); }
    .card--primary:hover .card-icon { transform: translateY(-50%) rotate(-4deg); }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
