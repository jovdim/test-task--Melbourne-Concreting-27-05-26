---
import { Image } from 'astro:assets';
import { problem, images } from '../data/site';
---

<section class="section problem grid-bg">
  <div class="container grid">
    <div class="media" data-reveal>
      <Image
        src={images.crackedDriveway}
        alt="Cracked and crumbling old suburban concrete driveway in need of replacement"
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 45vw"
        loading="lazy"
        class="media-img"
      />
      <span class="media-tag">The one you’re replacing</span>
    </div>

    <div class="copy">
      <p class="eyebrow" data-reveal>{problem.eyebrow}</p>
      <h2 data-reveal style="transition-delay:.05s" set:html={problem.h2}></h2>
      <p class="lede" data-reveal style="transition-delay:.1s">{problem.intro}</p>

      <ul class="pains">
        {problem.points.map((point, i) => (
          <li data-reveal style={`transition-delay:${0.14 + i * 0.07}s`}>
            <span class="x" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </span>
            {point}
          </li>
        ))}
      </ul>

      <p class="kicker" data-reveal>{problem.kicker}</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: stretch; }

  /* image stretches to match the text column height instead of a fixed tall ratio */
  .media { position: relative; min-height: 420px; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .media-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 78%; }
  .media-tag {
    position: absolute; left: 16px; bottom: 16px;
    background: rgba(22,24,29,.82); color: #fff; backdrop-filter: blur(4px);
    font-size: .82rem; font-weight: 500; padding: .5rem .85rem; border-radius: var(--r-pill);
  }

  .copy h2 { margin-top: 16px; }
  .copy .lede { margin-top: 18px; }

  .pains { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
  .pains li {
    display: grid; grid-template-columns: auto 1fr; gap: .85rem; align-items: start;
    font-size: 1.05rem; color: var(--graphite); line-height: 1.5;
  }
  .pains .x {
    flex: none; width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center; margin-top: 2px;
    background: #fbe9e6; color: #c0392b;
  }

  .kicker {
    margin-top: 30px; padding-left: 20px; border-left: 3px solid var(--accent);
    font-family: var(--font-head); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.35; color: var(--ink);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .media { min-height: 0; aspect-ratio: 16 / 11; }
  }
</style>
