---
import { Image } from 'astro:assets';
import { about, images } from '../data/site';
---

<section class="section about grid-bg" id="about">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>{about.eyebrow}</p>
      <h2 data-reveal style="transition-delay:.05s" set:html={about.h2}></h2>
      {about.paragraphs.map((p, i) => (
        <p class="para" data-reveal style={`transition-delay:${0.1 + i * 0.06}s`}>{p}</p>
      ))}
    </div>

    <div class="media" data-reveal style="transition-delay:.1s">
      <Image
        src={images.aboutCrew}
        alt="Melbourne Concreting Co crew on site at a residential job, carrying tools across a paved area"
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 46vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(36px, 5vw, 76px); align-items: stretch; }

  .copy { align-self: center; }
  .copy h2 { margin-top: 16px; }
  .para { margin-top: 16px; color: var(--slate); line-height: 1.7; }
  .para:first-of-type { font-size: 1.08rem; color: var(--graphite); }

  .media { position: relative; min-height: 400px; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* premium corner-bracket framing (blueprint motif) */
  .media::before, .media::after { content: ""; position: absolute; z-index: 2; width: 34px; height: 34px; pointer-events: none; }
  .media::before { top: 14px; left: 14px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .media::after { bottom: 14px; right: 14px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .copy { order: 1; }
    .media { order: 0; min-height: 0; aspect-ratio: 16 / 11; }
  }
</style>
