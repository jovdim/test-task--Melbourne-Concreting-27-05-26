---
import { Image, getImage } from 'astro:assets';
import { projects } from '../data/site';

// Pre-generate larger versions for the lightbox viewer.
const fulls = await Promise.all(
  projects.map((p) => getImage({ src: p.image, width: 1200, format: 'webp' }))
);
---

<section class="section section--sand gallery grid-bg" id="work">
  <div class="container">
    <div class="section-head center" data-reveal>
      <p class="eyebrow">Gallery</p>
      <h2>Driveways and slabs across Melbourne</h2>
    </div>

    <div class="grid">
      {projects.map((p, i) => (
        <button
          class="tile"
          type="button"
          data-tile
          data-full={fulls[i].src}
          aria-label={`View larger: ${p.alt}`}
          data-reveal
          style={`transition-delay:${(i % 3) * 0.06}s`}
        >
          <Image
            src={p.image}
            alt={p.alt}
            widths={[400, 640, 900]}
            sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"
            loading="lazy"
          />
          <span class="zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
          </span>
        </button>
      ))}
    </div>

    <p class="gallery-cta" data-reveal>
      Want yours to look like this?
      <a class="link-arrow" href="#quote">Get your free quote
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </p>
  </div>

  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Gallery viewer">
    <button class="lb-btn lb-close" data-lb-close type="button" aria-label="Close viewer">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button class="lb-btn lb-prev" data-lb-prev type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <figure class="lb-stage">
      <img class="lb-img" data-lb-img src="" alt="" />
      <figcaption class="lb-cap"><span class="lb-count" data-lb-count></span></figcaption>
    </figure>
    <button class="lb-btn lb-next" data-lb-next type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
</section>

<script>
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  if (lb) {
    const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-tile]')];
    const items = tiles.map((t) => ({
      full: t.getAttribute('data-full') || '',
      alt: t.querySelector('img')?.getAttribute('alt') || '',
    }));
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;

    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      img.src = items[idx].full;
      img.alt = items[idx].alt;
      count.textContent = `${idx + 1} / ${items.length}`;
    };
    const open = (i: number) => {
      show(i);
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => lb.classList.add('is-open'));
    };
    const close = () => {
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      if (reduce) { lb.hidden = true; return; }
      const done = () => { lb.hidden = true; lb.removeEventListener('transitionend', done); };
      lb.addEventListener('transitionend', done);
    };

    tiles.forEach((t, i) => t.addEventListener('click', () => open(i)));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', close);
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx - 1); });
    lb.querySelector('[data-lb-next]')?.addEventListener('click', (e) => { e.stopPropagation(); show(idx + 1); });
    lb.addEventListener('click', (e) => { if (e.target === lb || e.target === img.parentElement) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(idx - 1);
      else if (e.key === 'ArrowRight') show(idx + 1);
    });
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(6px, 0.8vw, 10px); }

  .tile {
    position: relative; margin: 0; padding: 0; border: 0; background: none; cursor: pointer;
    border-radius: 0; overflow: hidden; aspect-ratio: 4 / 3; box-shadow: var(--shadow-sm);
    display: block;
  }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .tile:hover :global(img), .tile:focus-visible :global(img) { transform: scale(1.06); }
  .zoom {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: rgba(15,16,20,.3); opacity: 0; transition: opacity .3s ease;
  }
  .tile:hover .zoom, .tile:focus-visible .zoom { opacity: 1; }
  .zoom svg { width: 36px; height: 36px; color: #fff; }

  .gallery-cta { margin-top: clamp(30px, 4vw, 48px); text-align: center; font-size: 1.15rem; color: var(--graphite); }
  .gallery-cta .link-arrow { font-size: 1.15rem; }

  /* lightbox */
  .lightbox {
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(56px, 9vw, 72px) clamp(58px, 9vw, 96px);
    background: rgba(12,13,16,.94); backdrop-filter: blur(4px);
    opacity: 0; transition: opacity .3s ease;
  }
  .lightbox.is-open { opacity: 1; }

  .lb-stage { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 100%; }
  .lb-img {
    max-width: min(1100px, 100%); max-height: 80vh; object-fit: contain;
    border-radius: 10px; box-shadow: 0 30px 80px rgba(0,0,0,.5); background: #1a1a1a;
  }
  .lb-cap { display: flex; gap: 12px; align-items: baseline; color: rgba(255,255,255,.82); font-size: .92rem; }
  .lb-count { color: rgba(255,255,255,.5); font-variant-numeric: tabular-nums; }

  .lb-btn {
    position: absolute; width: 50px; height: 50px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(255,255,255,.12); color: #fff; display: grid; place-items: center;
    transition: background .2s ease, transform .2s ease;
  }
  .lb-btn:hover { background: rgba(255,255,255,.24); }
  .lb-close { top: clamp(14px, 3vw, 26px); right: clamp(14px, 3vw, 26px); }
  .lb-prev { left: clamp(10px, 2vw, 28px); top: 50%; transform: translateY(-50%); }
  .lb-next { right: clamp(10px, 2vw, 28px); top: 50%; transform: translateY(-50%); }
  .lb-prev:hover, .lb-next:hover { transform: translateY(-50%) scale(1.06); }

  @media (prefers-reduced-motion: reduce) { .lightbox, .tile :global(img), .zoom, .lb-btn { transition: none; } }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .grid { gap: 6px; }
    .tile { aspect-ratio: 1 / 1; }
    .lb-btn { width: 42px; height: 42px; }
  }
</style>
